# CoachTactics environment variables.
# In Google AI Studio, set these in Settings -> Secrets (never commit real values).
# Self-hosted: copy to .env and fill in.

# Gemini API key. AI Studio injects this automatically.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL where the app is hosted (injected by AI Studio / Cloud Run).
APP_URL="MY_APP_URL"

# First super administrator, created on first boot when no SUPER_ADMIN exists.
# ADMIN_PASSWORD must be at least 10 characters. If it is missing, a random password is
# printed ONCE to the server log. In AI Studio you may not see that log, so set it here.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_min_10_chars"

# Session signing secret, at least 32 random characters (e.g. `openssl rand -hex 32`).
# Keeps users signed in across restarts. If unset, one is generated and stored in DATA_DIR.
AUTH_SECRET="CHANGE_ME_openssl_rand_hex_32"

# --- Optional -----------------------------------------------------------------------------

# One-shot admin recovery: set to true together with ADMIN_PASSWORD, restart once, then remove.
# ADMIN_RESET_PASSWORD=false

# Where users.json, drills.json and the persisted auth secret are stored.
# Mount a volume here in production. The AI Studio preview and Cloud Run reset this on restart.
# DATA_DIR=./data
# STORAGE_DRIVER=file

# Gemini models tried in order (comma-separated).
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MAX_OUTPUT_TOKENS=8192

# Abuse limits
# GENERATE_LIMIT_PER_10MIN=20
# MAX_DRILLS_PER_USER=300
# MAX_CACHED_DRILLS=500

# Reverse proxy trust. Default: 1 hop on Cloud Run, loopback elsewhere. Never set to "true".
# TRUST_PROXY=1

# CSP frame-ancestors value if the deployed app must only be embeddable by specific sites.
# FRAME_ANCESTORS="'self' https://example.com"

# PORT=3000
